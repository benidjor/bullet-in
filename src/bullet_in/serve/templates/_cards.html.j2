{% macro stage_badge(s) %}{% if s %}<span class="stage {{ s.tone }}{{ ' filled' if s.filled }}">{{ s.label }}</span>{% endif %}{% endmacro %}
{% macro card(a, dest=None, when=None, cls='', show_cred=True, thumb=False, hidden=False) %}
{% set show_thumb = thumb and a.image_url %}
<a class="item {{ a._grade }}{{ ' hasthumb' if show_thumb }}{{ ' ' ~ cls if cls }}"{% if hidden or not a._stage_disp %} style="display:none"{% endif %} href="{{ root }}article/{{ a.content_hash }}.html"
   data-hash="{{ a.content_hash }}" data-stage="{{ a._stage }}" data-tier="{{ a._tier_key }}"
   data-outlet="{{ a._outlet }}" data-journalist="{{ a._journalist }}"
   data-published="{{ a._published_iso }}" data-confidence="{{ a.confidence_score or 0 }}"
   data-text="{{ (a._title ~ ' ' ~ (a.summary_ko or '')) | lower }}">
  {% if show_thumb %}<div class="cimg"><img src="{{ a.image_url }}" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.closest('.item').classList.remove('hasthumb');this.closest('.cimg').remove()"></div>{% endif %}
  <div class="body">
    <div class="cardhead">{{ stage_badge(a._stage_disp) }}{% if dest %}<span class="dest">{{ dest }}</span>{% endif %}<span class="src">{{ a._outlet | replace(' (aggregator)', '') }}</span>{% if show_cred and a._reader_tier %}<span class="cred">{{ a._reader_tier }}</span>{% endif %}<span class="when">{{ when or a._time }}</span></div>
    <div class="htitle">{{ a._title }}{% if a._pending %} <span class="pending">번역 대기</span>{% endif %}</div>
    {% if a._show_summary and a.summary_ko %}<p class="dek">{{ a.summary_ko }}</p>{% endif %}
  </div>
</a>
{% endmacro %}
{% macro relitem(a, rep) %}<a class="relitem" href="{{ root }}article/{{ a.content_hash }}.html"
   data-outlet="{{ a._outlet }}" data-journalist="{{ a._journalist }}" data-tier="{{ a._tier_key }}"
   data-stage="{{ a._stage }}" data-text="{{ (a._title ~ ' ' ~ (a.summary_ko or '')) | lower }}"><span class="rt">{{ a._title }}</span><span class="rm">{{ a._outlet }}{% if a._reader_tier %} · {{ a._reader_tier }}{% endif %}{% if a._date and a._date != rep._date %} · {{ a._date }}{% endif %}</span></a>{% endmacro %}
