{% macro stage_badge(s) %}{% if s %}<span class="stage {{ s.tone }}{{ ' filled' if s.filled }}">{{ s.label }}</span>{% endif %}{% endmacro %}
{% macro card(a, when=None, cls='', show_cred=True, thumb=False, hidden=False) %}
{% set show_thumb = thumb and a.image_url %}
{# 단계 배지가 없는 카드 (「기타」) 는 어디서나 기본으로 보인다 (설계 2026-10-20) — 홈은
   「선수 · 팀 뉴스」 구역에, 공신력 최하는 가십 구역에 (사용자 결정 2026-10-20), 전체 기사는
   목록 그대로 둔다. 좁혀 보는 것은 사이드바 「뉴스 종류」 의 몫이다. #}
<a class="item {{ a._grade }}{{ ' hasthumb' if show_thumb }}{{ ' ' ~ cls if cls }}"{% if hidden %} style="display:none"{% endif %} href="{{ root }}article/{{ a.content_hash }}.html"
   data-hash="{{ a.content_hash }}" data-stage="{{ a._stage }}" data-kind="{{ a._kind }}" data-dir="{{ a._dir }}" data-tier="{{ a._tier_key }}"
   data-outlet="{{ a._outlet }}" data-journalist="{{ a._journalist }}"
   data-published="{{ a._published_iso }}" data-confidence="{{ a.confidence_score or 0 }}"
   data-text="{{ (a._title ~ ' ' ~ (a.summary_ko or '')) | lower }}">
  {% if show_thumb %}<div class="cimg"><img src="{{ a.image_url }}" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.closest('.item').classList.remove('hasthumb');this.closest('.cimg').remove()"></div>{% endif %}
  <div class="body">
    <div class="cardhead">{{ stage_badge(a._stage_disp) }}<span class="src">{{ a._outlet | replace(' (aggregator)', '') }}</span>{% if show_cred and a._reader_tier %}<span class="cred">{{ a._reader_tier }}</span>{% endif %}<span class="when">{{ when or a._time }}</span></div>
    <div class="htitle">{{ a._title }}{% if a._pending %} <span class="pending">번역 대기</span>{% endif %}</div>
    {% if a._show_summary and a.summary_ko %}<p class="dek">{{ a.summary_ko }}</p>{% endif %}
  </div>
</a>
{% endmacro %}
{# 같은 소식 줄 (2026-09-02) — 대표 카드 안에 한 줄씩 붙는다. 필터가 읽는 data-*
   는 옛 관련 보도 항목 (relitem) 이 갖던 것을 그대로 옮긴 것이다. #}
{% macro sameline(a) %}<a class="sameline" href="{{ root }}article/{{ a.content_hash }}.html"
   data-hash="{{ a.content_hash }}" data-stage="{{ a._stage }}" data-kind="{{ a._kind }}" data-dir="{{ a._dir }}"
   data-tier="{{ a._tier_key }}" data-outlet="{{ a._outlet }}"
   data-journalist="{{ a._journalist }}" data-published="{{ a._published_iso }}"
   data-confidence="{{ a.confidence_score or 0 }}"
   data-text="{{ (a._title ~ ' ' ~ (a.summary_ko or '')) | lower }}"><span class="sm">{{ a._outlet | replace(' (aggregator)', '') }}</span><span class="st">{{ a._title }}</span><span class="sw">{{ a._time }}</span></a>{% endmacro %}
