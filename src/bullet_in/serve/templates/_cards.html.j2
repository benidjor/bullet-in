{% macro stage_badge(s) %}{% if s %}<span class="stage {{ s.tone }}{{ ' filled' if s.filled }}">{{ s.label }}</span>{% endif %}{% endmacro %}
{% macro card(a, dest=None, when=None, cls='', show_cred=True, thumb=False, hidden=False, show_all=False) %}
{% set show_thumb = thumb and a.image_url %}
{# 기타 단계는 기본 숨김 (#22) 이나, 링크 선수 배지가 붙은 글은 예외로 노출한다
   — 배지가 존재 이유를 설명하는 글이라 숨기면 배지를 볼 수 없다 (2026-08-02).
   선수 페이지 (show_all) 는 귀속 기사 전량을 보여줘야 해서 이 기본 숨김을 끈다
   — 머리 건수와 목록 수가 어긋나면 안 되기 때문 (선수 페이지 스펙 §5.3). #}
<a class="item {{ a._grade }}{{ ' hasthumb' if show_thumb }}{{ ' ' ~ cls if cls }}"{% if hidden or (not show_all and not a._stage_disp and not a._ctx) %} style="display:none"{% endif %} href="{{ root }}article/{{ a.content_hash }}.html"
   data-hash="{{ a.content_hash }}" data-stage="{{ a._stage }}" data-dir="{{ a._dir }}" data-tier="{{ a._tier_key }}"{% if a._ctx %} data-ctx="1"{% endif %}
   data-outlet="{{ a._outlet }}" data-journalist="{{ a._journalist }}"
   data-published="{{ a._published_iso }}" data-confidence="{{ a.confidence_score or 0 }}"
   data-text="{{ (a._title ~ ' ' ~ (a.summary_ko or '')) | lower }}">
  {% if show_thumb %}<div class="cimg"><img src="{{ a.image_url }}" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.closest('.item').classList.remove('hasthumb');this.closest('.cimg').remove()"></div>{% endif %}
  <div class="body">
    <div class="cardhead">{{ stage_badge(a._stage_disp) }}{% if dest %}<span class="dest">{{ dest }}</span>{% endif %}<span class="src">{{ a._outlet | replace(' (aggregator)', '') }}</span>{% if show_cred and a._reader_tier %}<span class="cred">{{ a._reader_tier }}</span>{% endif %}{% if a._ctx %}<span class="ctx">{{ a._ctx }}</span>{% endif %}<span class="when">{{ when or a._time }}</span></div>
    <div class="htitle">{{ a._title }}{% if a._pending %} <span class="pending">번역 대기</span>{% endif %}</div>
    {% if a._show_summary and a.summary_ko %}<p class="dek">{{ a.summary_ko }}</p>{% endif %}
  </div>
</a>
{% endmacro %}
{% macro relitem(a, rep) %}<a class="relitem" href="article/{{ a.content_hash }}.html"
   data-outlet="{{ a._outlet }}" data-journalist="{{ a._journalist }}" data-tier="{{ a._tier_key }}"
   data-stage="{{ a._stage }}" data-dir="{{ a._dir }}" data-text="{{ (a._title ~ ' ' ~ (a.summary_ko or '')) | lower }}"><span class="rt">{{ a._title }}</span><span class="rm">{{ a._outlet }}{% if a._reader_tier %} · {{ a._reader_tier }}{% endif %}{% if a._date and a._date != rep._date %} · {{ a._date }}{% endif %}</span></a>{% endmacro %}
