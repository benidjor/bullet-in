{% extends "_layout.html.j2" %}
{% block title %}선수 · Bullet-in{% endblock %}
{% block content %}
<div class="sechead"><h2>선수</h2>
  <span class="secside"><span class="kst">이적 축별</span>
    <button class="plsort" id="plSort" type="button" data-mode="recent">최근 보도순</button>
  </span></div>
{% for g in groups %}{% if g.members %}
<div class="plgrp{{ ' folded' if g.collapsed }}">
  <h3 class="plgroup">{{ g.name }} <span class="ct">{{ g.members|length }}</span>
    <button class="plfold" type="button">{{ '펼치기' if g.collapsed else '접기' }}</button>
  </h3>
  <div class="playerlist">
  {% for e in g.members %}
    <a class="pcard{{ ' hasphoto' if e._photo }}" href="player/{{ e.slug }}.html"
       data-last="{{ e._lastkey }}" data-name="{{ e._namekey }}">
      {# 실패하면 사진 칸을 통째로 걷어낸다 — 안 걷으면 빈 회색 상자가 남는다.
         기사 썸네일 (_cards.html.j2) 과 같은 규약이다. #}
      {% if e._photo %}<span class="pphoto"><img src="{{ e._photo }}" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.closest('.pcard').classList.remove('hasphoto');this.closest('.pphoto').remove()"></span>{% endif %}
      <span class="pbody">
        <span class="pname">{{ e.name }}</span>
        {% if e._badge %}<span class="tbadge {{ e._badge.cls }}">{{ e._badge.label }}</span>{% endif %}
        {% if e._stage %}<span class="stage {{ e._stage.tone }}{{ ' filled' if e._stage.filled }}">{{ e._stage.label }}</span>{% endif %}
        {% if e._club %}<span class="pclub">{{ e._club }}</span>{% endif %}
        <span class="pmeta">기사 {{ e.count }}건 · 최근 {{ e._last }}</span>
      </span>
    </a>
  {% endfor %}
  </div>
</div>
{% endif %}{% endfor %}
{% endblock %}
