{% extends "_layout.html.j2" %}
{% block title %}Bullet-in · 아스날 이적 뉴스{% endblock %}

{% from "_cards.html.j2" import stage_badge, card, sameline %}

{% block band %}
{% if lead %}
<div class="bandwrap">
<section class="band">
  <article class="lead">
    <a href="article/{{ lead.content_hash }}.html">
      {% if lead.image_url %}<div class="limg"><img src="{{ lead.image_url }}" alt="" loading="eager" referrerpolicy="no-referrer" onerror="this.closest('.limg').style.display='none'"></div>{% endif %}
      <div class="cardhead">{{ stage_badge(lead._stage_disp) }}<span class="src">{{ lead._outlet }}</span>{% if lead._reader_tier %}<span class="cred">{{ lead._reader_tier }}</span>{% endif %}<span class="when">{{ lead._date or lead._when }}</span></div>
      <h2>{{ lead._title }}</h2>
      {% if lead.summary_ko %}<p class="dek">{{ lead.summary_ko }}</p>{% endif %}
    </a>
  </article>
  <div class="mains">
    <h3 class="bandhead">주요 소식</h3>
    {% for m in mains %}
    <a class="mitem" href="article/{{ m.content_hash }}.html" data-hash="{{ m.content_hash }}" data-stage="{{ m._stage }}" data-tier="{{ m._tier_key }}" data-outlet="{{ m._outlet }}">
      {% if m.image_url %}<div class="rimg"><img src="{{ m.image_url }}" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.closest('.rimg').style.display='none'"></div>{% else %}<div class="rimg"></div>{% endif %}
      <div>
        <div class="cardhead">{{ stage_badge(m._stage_disp) }}<span class="src">{{ m._outlet }}</span>{% if m._reader_tier %}<span class="cred">{{ m._reader_tier }}</span>{% endif %}<span class="when">{{ m._date or m._when }}</span></div>
        <h3>{{ m._title }}</h3>
      </div>
    </a>
    {% endfor %}
  </div>
</section>
</div>
{% endif %}
{% endblock %}

{% block content %}
{# 홈은 두 구역이다 (설계 2026-10-20 §3) — 위 「이적 뉴스」 · 아래 「선수 · 팀 뉴스」.
   머리글 건수는 「그 구역에 실제로 놓인 오늘치」 다 (2026-08-30 c안을 구역마다).
   가십 바로가기는 첫 구역 머리글에만 단다 — 가십이 0건이면 걸지 않는다. #}
{% for s in sections if s.days %}
<section class="sect" data-kind="{{ s.kind }}">
<div class="sechead"><h2>{{ s.title }}</h2><span class="secside"><span class="kst">오늘 {{ s.today }}건{% if loop.first and gossip_today %} · <a class="gossipjump" href="#gossip">가십 {{ gossip_today }}건</a>{% endif %}{% if loop.first %} · 시각 KST 기준{% endif %}</span>{% if loop.first %}<a class="seclink" href="all.html">전체 기사 보기</a>{% endif %}</span></div>

{# 첫 화면 카드 상한은 app.js 가 건다 (data-cap · 정렬을 바꿔도 다시 센다). #}
<div class="latest{{ ' latestcut' if s.cut }}" data-cap="6">
{% for day in s.days %}
<div class="daygroup{{ ' dg-extra' if day.extra }}" data-date="{{ day.date }}">
<div class="daydiv"{% if day.all_dup %} style="display:none"{% endif %}><span class="d">{{ day.label }}</span><span class="c">묶음 {{ day.n }}개 · 보도 {{ day.reports }}건</span></div>
<div class="daylist">
  {% for b in day.blocks %}
  {# 대표의 공신력 등급을 블록에도 싣는다 — 아래 줄이 카드와 같은 배경을 쓰게
     (2026-08-28). 등급이 카드 안쪽에만 있으면 그 줄만 흰 바탕으로 떠 보인다. #}
  <div class="block {{ b.rep._grade }}{{ ' lowsolo' if b.lowsolo }}"{% if b.band_dup %} style="display:none"{% endif %}>
    {{ card(b.rep, thumb=True, cls='dupcard' if b.band_dup else '', hidden=b.band_dup) }}
    {# 같은 날 · 같은 선수 · 같은 단계 보도를 줄로 붙인다 (2026-09-02). 접지 않으므로
       버튼이 없다 — 그날 들어온 기사는 카드나 줄 어느 한쪽에 반드시 한 번 나온다.
       기준 라벨은 줄이 있을 때만 붙는다 · 혼자 선 카드는 지금처럼 깨끗하다. #}
    {% if b.same %}
    <div class="same">
      <div class="keyline"><span class="key">{{ b.key }}{% if b.stage_group %} · {{ b.stage_group }}{% endif %}</span><span class="keyn">보도 {{ b.same|length + 1 }}건</span></div>
      {% for a in b.same %}{{ sameline(a) }}{% endfor %}
    </div>
    {% endif %}
    {% if b.story %}
    <div class="blocknav"><a class="storylink" href="player/{{ b.story.slug }}.html">{{ b.key }} 더보기 · 기사 {{ b.story.count }}건</a></div>
    {% endif %}
  </div>
  {% endfor %}
</div>
</div>
{% endfor %}
</div>
<button class="capmore" type="button" hidden></button>
{% if s.cut %}<button class="latestmore" type="button">이전 날짜 더보기 · {{ s.hidden_days }}개 날짜</button>{% endif %}
</section>
{% endfor %}

{% if gossip %}
<div class="sechead gossiphead" id="gossip"><h2>가십</h2><span class="secside"><span class="kst">최근 {{ gossip_days }}일 {{ gossip_shown }}건 · 전체 {{ gossip_total }}건</span><a class="seclink" href="all.html">전체 기사 보기</a></span></div>
<div class="gossiplist{{ ' weekcut' if gossip_hidden }}">
  {% for a in gossip %}{{ card(a, when=a._gwhen, cls='gwk' if a._gwk else '', show_cred=False, hide_other=True) }}{% endfor %}
</div>
{% if gossip_hidden %}<button class="gossipmore" id="gossipMore" type="button">이전 날짜 가십 더보기 · {{ gossip_hidden }}건</button>{% endif %}
<p class="gossipnote">공신력 최하 보도는 사건 묶음과 상관없이 모두 여기에 모읍니다.</p>
{% endif %}

<footer class="sitefoot">
  <p>Bullet-in 은 아스날 관련 보도를 여러 매체에서 모아 한국어로 옮겨 보여 줍니다. 본문은 자동 번역이며 원문 링크를 함께 싣습니다.</p>
  <p>저작권은 각 매체에 있습니다 · <a href="all.html">전체 기사</a> · <a href="about.html">소개</a>{% if ga_id %} · <a href="about.html#stats">접속 통계 안내</a>{% endif %}</p>
</footer>
{% endblock %}
