{% extends "_layout.html.j2" %}
{% block title %}Bullet-in · 아스날 이적 뉴스{% endblock %}

{% from "_cards.html.j2" import stage_badge, card, relitem %}

{% block band %}
{% if lead %}
<div class="bandwrap">
<section class="band">
  <article class="lead">
    <a href="article/{{ lead.content_hash }}.html">
      {% if lead.image_url %}<div class="limg"><img src="{{ lead.image_url }}" alt="" loading="eager" referrerpolicy="no-referrer" onerror="this.closest('.limg').style.display='none'"></div>{% endif %}
      <div class="cardhead">{{ stage_badge(lead._stage_disp) }}<span class="src">{{ lead._outlet }}</span>{% if lead._reader_tier %}<span class="cred">{{ lead._reader_tier }}</span>{% endif %}<span class="when">{{ lead._date or lead._when }}</span></div>
      <h2>{{ lead._title }}</h2>
      {% if lead.summary_ko %}<p class="dek">{{ lead.summary_ko }}</p>{% endif %}
    </a>
  </article>
  <div class="mains">
    <h3 class="bandhead">주요 소식</h3>
    {% for m in mains %}
    <a class="mitem" href="article/{{ m.content_hash }}.html">
      {% if m.image_url %}<div class="rimg"><img src="{{ m.image_url }}" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.closest('.rimg').style.display='none'"></div>{% else %}<div class="rimg"></div>{% endif %}
      <div>
        <div class="cardhead">{{ stage_badge(m._stage_disp) }}<span class="src">{{ m._outlet }}</span>{% if m._reader_tier %}<span class="cred">{{ m._reader_tier }}</span>{% endif %}<span class="when">{{ m._date or m._when }}</span></div>
        <h3>{{ m._title }}</h3>
      </div>
    </a>
    {% endfor %}
  </div>
</section>
</div>
{% endif %}
{% endblock %}

{% block content %}
<div class="sechead"><h2>최신 소식</h2><span class="kst">시각 KST 기준 · <a class="seclink" href="all.html">전체 기사 →</a></span></div>

<div class="latest{{ ' latestcut' if day_blocks|length > 3 }}">
{% for day in day_blocks %}
<div class="daygroup{{ ' dg-extra' if loop.index > 3 }}" data-date="{{ day.date }}">
<div class="daydiv"{% if day.all_dup %} style="display:none"{% endif %}><span class="d">{{ day.label }}</span><span class="c">묶음 {{ day.n }}개 · 보도 {{ day.reports }}건</span></div>
<div class="daylist">
  {% for b in day.blocks %}
  <div class="block"{% if b.band_dup %} style="display:none"{% endif %}>
    {{ card(b.rep, thumb=True, cls='dupcard' if b.band_dup else '', hidden=b.band_dup) }}
    {% if b.ending %}{{ card(b.ending.article, dest=b.ending.club, thumb=True) }}{% endif %}
    {% if b.rel_count %}
    <button class="reltoggle" type="button" aria-expanded="false">관련 보도 {{ b.rel_count }}건</button>
    <div class="related" hidden>
      {% for br in b.branches %}
      {% if br.label %}<div class="branchlabel">{{ br.label }}</div>{% endif %}
      {% for a in br.articles %}{{ relitem(a, b.rep) }}{% endfor %}
      {% endfor %}
    </div>
    {% endif %}
  </div>
  {% endfor %}
</div>
</div>
{% endfor %}
</div>
{% if day_blocks|length > 3 %}<button class="latestmore" id="latestMore" type="button">이전 날짜 더보기 · {{ day_blocks|length - 3 }}개 날짜</button>{% endif %}

{% if gossip %}
<div class="sechead gossiphead"><h2>가십</h2><span class="kst">묶음 {{ gossip_n }}개 · <a class="seclink" href="all.html">전체 기사 →</a></span></div>
<div class="gossiplist{{ ' weekcut' if gossip_hidden }}">
  {% for a in gossip %}{{ card(a, when=a._gwhen, cls='dupcard' if a._dup else ('gwk' if a._gwk else ''), hidden=a._dup, show_cred=False) }}{% endfor %}
</div>
{% if gossip_hidden %}<button class="gossipmore" id="gossipMore" type="button">이전 날짜 가십 더보기 · {{ gossip_hidden }}건</button>{% endif %}
<p class="gossipnote">나머지 최하 등급 보도는 위 사건 묶음 안에 들어 있습니다.</p>
{% endif %}

<footer class="sitefoot">
  <p>Bullet-in 은 아스날 관련 보도를 여러 매체에서 모아 한국어로 옮겨 보여 줍니다. 본문은 자동 번역이며 원문 링크를 함께 싣습니다.</p>
  <p>저작권은 각 매체에 있습니다 · <a href="all.html">전체 기사</a> · <a href="about.html">소개</a> · <a href="ops.html">수집 현황</a></p>
</footer>
{% endblock %}
