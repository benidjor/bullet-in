[Unit]
Description=bullet-in 운영 마트 변경 이력 적재 (MariaDB -> Iceberg on GCS)
Wants=docker.service
After=docker.service network-online.target
OnFailure=bullet-in-fail-notify@%n.service

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/bullet-in
EnvironmentFile=/home/ubuntu/bullet-in/.env
# .env 의 GOOGLE_APPLICATION_CREDENTIALS 는 백업 계정을 가리킨다.
# 백업 계정에는 객체 삭제 권한이 없는데 변경 이력 유지보수는 파일을 지워야 해서,
# 변경 이력 유닛에서만 변경 이력 전용 계정을 쓴다.
#
# Environment= 로는 못 덮는다 — systemd 가 EnvironmentFile= 을 나중에 읽어
# Environment= 로 지정한 값을 덮어쓰고, 줄 순서를 바꿔도 결과가 같다.
# 실제로 그렇게 적었다가 백업 계정으로 붙어 403 USER_PROJECT_DENIED 가 났다.
# env 는 프로세스를 띄우는 순간에 값을 넣으므로 이 순서를 타지 않는다.
ExecStart=/usr/bin/env GOOGLE_APPLICATION_CREDENTIALS=/home/ubuntu/.bullet-in-lakehouse.json /home/ubuntu/.local/bin/uv run python -m bullet_in.warehouse load
TimeoutStartSec=1800
